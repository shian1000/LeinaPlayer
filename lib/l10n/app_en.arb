  "privacyScreenGoGitHub": "Sync › Database › GitHub",
  "privacyScreenGoUpdates": "About and help › Check for updates",
  "privacyScreenYouTubeText": "Playing audio from videos, searching, matching songs to videos and importing playlists. The app connects to YouTube like an anonymous browser (the NewPipe library): without an account and without a key. YouTube gets video ids and what you search for (title and artist). Played songs stay in the cache; the next ones in the queue may be downloaded ahead.",
  "privacyScreenStatusPlayback": "playback",
  "privacyScreenStatusSearch": "search",
  "privacyScreenGoPlaybackSources": "Playback › Sources, including YouTube",
  "privacyScreenGoYouTube": "YouTube: search and API key",
  "privacyScreenGoCache": "Cache: downloading ahead",
  "privacyScreenGoogleSection": "Google account",
  "privacyScreenGoogleText": "“Create on YouTube” creates a playlist on your YouTube account: you sign in in a Google window, then the playlist’s name and its videos go to the YouTube Data API. The app remembers only the account’s email address.",
  "privacyScreenGoogleSignedIn": "connects to the internet on “Create on YouTube”, signed in as {email}",
  "privacyScreenGoGoogleSignOut": "Account › Sign out of Google",
  "privacyScreenGoogleUnsupported": "doesn’t connect — this version of the app doesn’t have this feature",
  "privacyScreenGoogleSignedOut": "doesn’t connect — you’re not signed in",
  "privacyScreenGoogleOnlyWhenUsed": "Only when you tap “Create on YouTube” yourself.",
  "privacyScreenSpotifyText": "Importing playlists, albums and tracks from Spotify links and searching Spotify playlists. Spotify gets the playlist / album / track id or what you search for. Without an account (with an API key only if you enter one).",
  "privacyScreenStatusPlaylistSearch": "playlist search",
  "privacyScreenGoSpotify": "Spotify: playlist search and API key",
  "privacyScreenSpotifyOnlyWhenUsed": "Import from a link — only when you open a Spotify link yourself.",
  "privacyScreenCoversSection": "Covers: iTunes, Deezer, YouTube thumbnails",
  "privacyScreenCoversText": "Album covers that aren’t in the file on the phone. The services get the artist and album (or title) or the video id; a song from the database with no link and no cover is also searched for on YouTube by artist and title. A cover that’s found stays in the cache.",
  "privacyScreenStatusWifiOnly": "Wi-Fi only",
  "privacyScreenGoCoverSources": "Cover sources (each separately)",
  "privacyScreenGoCoversWifi": "Data saver › Covers only over Wi-Fi",
  "privacyScreenLyricsSection": "LRCLIB: lyrics",
  "privacyScreenLyricsText": "The song’s lyrics on the card under the player, when the full player is open and the MusicDatabase server doesn’t have this song’s lyrics (or doesn’t answer). LRCLIB (a community project) gets the song’s title, artist, album and length. Lyrics aren’t stored on the phone.",
  "privacyScreenGoLyrics": "Data saver › Download lyrics",
  "privacyScreenBrowserSection": "Browser and “Share”",
  "privacyScreenBrowserText": "Links in Song info (MusicBrainz, Apple Music, Deezer, Spotify), the source code and downloading a new version open in the browser. The request package, a problem report (app version, phone model, your description and the error log), a backup (your data without logins and API keys), links and summaries go to the app you choose in “Share”. The error log is kept only on the phone (the last 14 days).",
  "privacyScreenBrowserNotConnecting": "doesn’t connect by itself",
