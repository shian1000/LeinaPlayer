# Copy to tool/release.env (git-ignored) to build the APK you hand out to others.
# tool/build_release_apk.sh passes these to the app; without the file the features stay off.

# GitHub repository whose releases carry this app's APK, as owner/repo. The app checks it for
# newer builds (Informacje i pomoc › Aktualizacje). Leave unset in a build of your own unless
# you publish your own releases signed with your own key.
UPDATE_REPO=owner/repo

# Web OAuth client id of your Google Cloud project, for "Utwórz na YouTube" (making a YouTube
# playlist from a Biblioteka one). The project also needs YouTube Data API v3 and an Android
# OAuth client with this app's package name and YOUR signing key's SHA-1 (README › Building).
# Unset: the button is left out.
GOOGLE_WEB_CLIENT_ID=0000000000-xxxxxxxx.apps.googleusercontent.com
